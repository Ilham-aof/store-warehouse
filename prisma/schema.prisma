// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  Admin
  Staff
}

enum StockInType {
  STOCK_AWAL
  PEMBELIAN
  TRANSFER
  RETUR
}

enum StockOutType {
  SERVIS
  PENJUALAN
  TRANSFER
}

enum ServiceStatus {
  Diproses
  Sukses
  Cancel
}

model User {
  id                  String            @id @default(cuid())
  name                String
  email               String            @unique
  password            String
  phone               String
  role                Role              @default(Staff)

  sessions            Session[]
  stockIns            StockIn[]
  stockOuts           StockOut[]
  saleReceipts        SaleReceipt[]
  serviceReceipts     ServiceReceipt[]

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Outlet {
  id                String            @id @default(cuid())
  name              String            @unique
  code              String            @unique
  address           String    
  phone             String    


  products          Product[]
  serviceReceipts   ServiceReceipt[]
  saleReceipts      SaleReceipt[]
  saleReceiptCounters SaleReceiptCounter[]
  
  stockInsFromHere  StockIn[]         @relation("StockInSourceOutlet")
  stockOutsToHere   StockOut[]        @relation("StockOutDestinationOutlet")

}

model Product {
  id        String        @id @default(cuid())
  barcode   String
  name      String
  category  String
  brand     String
  price     Int
  quantity  Int

  outletId  String
  outlet    Outlet        @relation(fields: [outletId], references: [id])

  stockIns  StockIn[]
  stockOuts StockOut[]
  saleItems SaleItem[]
  
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([outletId, barcode])
}

model StockIn {
  id        String        @id @default(cuid())
  productId String
  userId    String
  quantity  Int
  type      StockInType
  getFrom   String?  
  createdAt DateTime      @default(now())

  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  sourceOutlet Outlet?    @relation("StockInSourceOutlet", fields: [getFrom], references: [id], onDelete: Cascade)
}

model StockOut {
  id        String          @id @default(cuid())
  productId String
  userId    String
  quantity  Int
  type      StockOutType
  sendTo    String?
  createdAt DateTime        @default(now())

  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  destinationOutlet Outlet? @relation("StockOutDestinationOutlet", fields: [sendTo], references: [id], onDelete: Cascade)
}

model ServiceReceipt {
  id                String        @id @default(cuid())
  invoiceNumber     String        @unique

  customerName      String
  customerPhone     String
  device            String
  deviceInclusions  String[]      @default([])

  discount          Int           @default(0)

  processStatus     Boolean       @default(false)
  pickupStatus      Boolean       @default(false)
  receiptStatus     ServiceStatus @default(Diproses)
  
  outletId          String
  userId            String

  outlet            Outlet        @relation(fields: [outletId], references: [id])
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  serviceItems      ServiceItem[]
}

model ServiceItem {
  id          String         @id @default(cuid())
  receiptId   String

  description String
  price       Int

  warrantyDays      Int
  warrantyUntil     DateTime?

  receipt     ServiceReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
}

model SaleReceipt {
  id            String     @id @default(cuid())
  invoiceNumber String     @unique
  totalAmount   Int
  outletId      String
  userId        String

  outlet        Outlet     @relation(fields: [outletId], references: [id], onDelete: Cascade)
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  saleItems     SaleItem[]

  createdAt     DateTime   @default(now())

}

model SaleItem {
  id                  String      @id @default(cuid())

  saleReceiptId       String
  productId           String

  productName         String
  productBarcode      String
  productPrice        Int
  productQuantity     Int
  subtotal            Int

  saleReceipt         SaleReceipt @relation(fields: [saleReceiptId], references: [id], onDelete: Cascade)
  product             Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model SaleReceiptCounter {
  id         String   @id @default(cuid())
  outletId   String
  date       String
  lastNumber Int      @default(0)

  outlet Outlet @relation( fields: [outletId], references: [id], onDelete: Cascade )
  @@unique([outletId, date])
}